# Copy to .env and fill in. Never commit .env.

# demo | production
APP_MODE=production
PORT=3000

# The exact public HTTPS origin people open (no trailing slash).
# Passkeys are tied to this domain: choose it before go-live.
APP_ORIGIN=https://portal.example.bh

# Where the database and private files (selfies, documents) live. Keep it outside the web root.
DATA_DIR=./data

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts two-step sign-in secrets at rest. Required in production.
APP_ENCRYPTION_KEY=

# Set to true when running behind nginx/Caddy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# Optional: Google Maps JavaScript API browser key (restrict to your HTTPS origin and to Maps JavaScript API).
GOOGLE_MAPS_BROWSER_KEY=
# Optional: Map ID from Google Maps Platform → Map management (needed for Advanced Markers).
GOOGLE_MAPS_MAP_ID=
